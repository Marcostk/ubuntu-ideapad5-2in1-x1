// SPDX-License-Identifier: BSD-3-Clause
/*
 * UbuntoARM: teclado e touchpad do IdeaPad 5 2-in-1 (83GH) sobre o DTB do Slim 5x.
 * No 83GH estão no i2c2 (b88000), não no i2c0 como no Slim 5x. Mesmos dispositivos e
 * interrupções (GPIO 3 touchpad, GPIO 67 teclado), copiados de x1p42100-lenovo-ideapad-5-2in1.dts.
 * 8 = IRQ_TYPE_LEVEL_LOW.
 */
/dts-v1/;
/plugin/;

&i2c0 {
	status = "disabled";
};

&i2c2 {
	clock-frequency = <400000>;
	pinctrl-0 = <&qup_i2c2_data_clk>, <&tpad_default>, <&kybd_default>;
	pinctrl-names = "default";
	status = "okay";

	/* ELAN06FA */
	touchpad@15 {
		compatible = "hid-over-i2c";
		reg = <0x15>;
		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 3 8>;
		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;
		wakeup-source;
	};

	/* CIRQ1080 or SYNA2BA6 */
	touchpad@2c {
		compatible = "hid-over-i2c";
		reg = <0x2c>;
		hid-descr-addr = <0x20>;
		interrupts-extended = <&tlmm 3 8>;
		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;
		wakeup-source;
	};

	/* FTCS0038 */
	touchpad@38 {
		compatible = "hid-over-i2c";
		reg = <0x38>;
		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 3 8>;
		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;
		wakeup-source;
	};

	keyboard@3a {
		compatible = "hid-over-i2c";
		reg = <0x3a>;
		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 67 8>;
		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;
		wakeup-source;
	};

	/* GXTP5100 */
	touchpad@5d {
		compatible = "hid-over-i2c";
		reg = <0x5d>;
		hid-descr-addr = <0x1>;
		interrupts-extended = <&tlmm 3 8>;
		vdd-supply = <&vreg_misc_3p3>;
		vddl-supply = <&vreg_l12b_1p2>;
		wakeup-source;
	};
};
