+/*
+ * UbuntoARM: o ADSP do Snapdragon X apaga arquivos do registro de sensores antes de regravá-los.
+ * O registro servido é uma cópia somente leitura (gerada no Windows), então só registra o pedido.
+ */
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	if (inbufs[1].s == 0 || ((const char *) inbufs[1].p)[inbufs[1].s - 1] != 0)
+		return AEE_EBADPARM;
+
+	fprintf(stderr, "fremove(%s): ignorado (registro somente leitura)\n",
+		(const char *) inbufs[1].p);
+
+	return 0;
+}
